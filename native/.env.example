# 앱이 어느 서버에 묻는가
#
# 이 값들은 **번들에 박힌다** (`EXPO_PUBLIC_` 은 그런 뜻이다). 앱 파일을
# 뜯으면 보인다 — 그래서 여기 진짜 비밀을 적지 마라. DB 접속 문자열,
# Supabase 키, ANTHROPIC_API_KEY 는 **서버에만** 둔다 (web/.env).

# 웹 앱이 도는 주소. 폰에서 개발할 때는 localhost 가 아니라 PC 의 IP 다
# (폰에게 localhost 는 폰 자신이다)
EXPO_PUBLIC_API_URL=http://192.168.0.10:3000

# 서버의 APP_API_TOKEN 과 **같은 값**. 24자 이상이어야 서버가 문을 연다
# (`web/lib/api/guard.ts`). 로그인이 아니라 자물쇠다 — 새면 서버에서
# 바꾸고 앱을 다시 올린다
#
# **여기에 ANTHROPIC_API_KEY(sk-ant-...) 나 Supabase 키를 넣지 마라.**
# 한 번 그럴 뻔했다 (2026-09-19). EXPO_PUBLIC_ 은 앱 번들에 **그대로
# 박혀서**, 앱 파일을 뜯는 누구나 꺼내 쓴다 — 진짜 키를 넣으면 그 순간
# 남의 돈으로 쓰이는 키가 된다. 그 키들은 서버(web/.env)에만 둔다.
# CI 가 번들을 grep 해서 'sk-ant-' 가 섞이면 막는다
EXPO_PUBLIC_API_TOKEN=
