# 앱이 DB 에 붙는 값. 복사해서 .env.local 로 쓴다 (.env.local 은 커밋 안 됨).
#
#   cp .env.example .env.local
#
# Supabase 대시보드 > Project Settings > API 에서 가져온다.

SUPABASE_URL=https://<프로젝트>.supabase.co

# service_role 키다. RLS 를 통과하는 열쇠라 서버 밖으로 나가면 안 된다.
# NEXT_PUBLIC_ 을 붙이지 마라 — 붙는 순간 브라우저 번들에 실린다.
# (왜 anon 키를 안 쓰는지는 db/policy.sql 머리말 참조)
SUPABASE_SERVICE_ROLE_KEY=

# 마이그레이션을 올릴 때만 쓴다 (supabase db push / tools/verify_migration.py).
# Supabase 대시보드 > Project Settings > Database > Connection string.
# DATABASE_URL=postgresql://postgres:<비밀번호>@db.<프로젝트>.supabase.co:5432/postgres
