# 앱이 쓰는 값. 복사해서 .env.local 로 쓴다 (.env.local 은 커밋 안 됨).
#
#   cp .env.example .env.local

# --- DB (필수) ------------------------------------------------------
# PostgreSQL 에 직접 붙는다. Supabase 는 호스팅된 Postgres 로 쓴다.
#
# 서버리스(Vercel)에 올릴 거면 **Transaction pooler** 주소를 써라.
# Supabase 대시보드 > Connect > Transaction pooler (포트 6543).
# direct(5432) 로 붙으면 무료 요금제의 접속 수가 금방 바닥난다.
#
# 로컬 PostgreSQL 로 돌려도 된다:
#   DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/recipe
DATABASE_URL=

# 인스턴스당 접속 수. 기본값은 로컬 5, 그 외 1이다. 보통 안 건드린다.
# DB_POOL_MAX=1

# --- 캡처 읽기 (작업 순서 4번부터 필요) ------------------------------
# 캡처를 재료·만드는 법으로 정리할 때 쓴다. 레시피 1건에 12~24원.
ANTHROPIC_API_KEY=

# 파싱에 쓸 모델. 기본은 claude-sonnet-5 다.
# 바꾸면 tools/accuracy_test.py 로 정확도를 다시 재라.
# PARSER_MODEL=claude-sonnet-5

# --- 원본 보관 (원칙 ⑤) ---------------------------------------------
# 캡처 원본은 절대 지우지 않는다. 파서가 좋아지면 전부 재파싱한다.
# 아래 둘이 있으면 Supabase Storage 로, 없으면 디스크로 간다.
# SUPABASE_URL=https://<프로젝트>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=originals

# 디스크에 남길 때의 자리. 개발 기본값은 ../.local/originals 다.
# ORIGINALS_DIR=

# --- 개발용 ----------------------------------------------------------
# 1 이면 LLM 을 부르지 않고 고정된 예시 응답으로 화면을 돌려본다.
# 운영(NODE_ENV=production)에서는 무시된다.
# PARSER_FAKE=1

# 위 값들은 전부 서버에서만 쓴다. NEXT_PUBLIC_ 을 붙이지 마라 —
# 붙는 순간 브라우저 번들에 실린다 (web/lib/db.ts 머리말 참조).
