# 앱이 DB 에 붙는 값. 복사해서 .env.local 로 쓴다 (.env.local 은 커밋 안 됨).
#
#   cp .env.example .env.local
#
# PostgreSQL 에 직접 붙는다. Supabase 는 호스팅된 Postgres 로 쓴다.
# 대시보드 > Project Settings > Database > Connection string 에서 가져온다.
# (서버리스에 올릴 거면 direct 대신 pooler 주소를 쓴다)
#
# 로컬 PostgreSQL 로 돌려도 된다:
#   DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/recipe

DATABASE_URL=

# 이 값은 서버에서만 쓴다. NEXT_PUBLIC_ 을 붙이지 마라 —
# 붙는 순간 접속 문자열이 브라우저 번들에 실린다.
# 브라우저는 DB 에 붙지 않는다 (web/lib/db.ts 머리말 참조).
